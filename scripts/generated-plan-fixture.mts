import type {Candidates,AIPlan} from '../lib/ai/plan-builder';
export function fixturePlan(c:Candidates):AIPlan{return{summary:'En konkret plan fra en tydeligt mærket testmodel.',sessions:c.sessions.map(d=>({weekday:d.weekday,title:'Testmodel · '+d.weekday,notes:'Kontrollerede bevægelser.',exercises:d.patterns.map(pat=>({id:d.options.find(o=>o.pattern===pat)!.id,sets:2,minReps:8,maxReps:10,restSeconds:60,reason:'Matcher udstyr og bevægelse.'}))})),meals:c.mealSlots.map(s=>({key:s.key,id:s.options[1].id})),cardio:c.cardioSlots.map(s=>({key:s.key,id:s.options[0].id})),injuryAdvice:[],progression:'Øg først efter gentagne kontrollerede pas med overskud.',citations:[],needsReview:false,reviewReason:''};}
